{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "players.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1.js"
    },
    {
      "src": "^/matchcenter$",
      "dest": "/public/matchcenter-advanced.html"
    },
    {
      "src": "^/icon.svg$",
      "dest": "/public/icon.svg"
    },
    {
      "src": "^/manifest.webmanifest$",
      "dest": "/public/manifest.webmanifest"
    },
    {
      "src": "^/players.html$",
      "dest": "/players.html"
    },
    {
      "src": "^/public/(.*)$",
      "dest": "/public/$1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/warm",
      "schedule": "15 5 * * *"
    }
  ]
}
