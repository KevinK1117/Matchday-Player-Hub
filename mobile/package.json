{
  "name": "matchday-pro-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare.mjs && vite build && node scripts/assets.mjs",
    "sync": "npm run build && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "check": "node --check src/native.js && node --check scripts/prepare.mjs",
    "setup:native": "npm run build && node scripts/setup-native.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@revenuecat/purchases-capacitor": "14.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "vite": "8.3.5"
  }
}
